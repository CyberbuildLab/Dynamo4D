    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\nfrom itertools import compress\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\nelements = IN[0]\r\nboolean_lists = IN[1]\r\n\r\n#create lists for filtered elements based on category\r\ncategory_filtered = []\r\nfor i in range(len(boolean_lists)):\r\n    category_filtered.append([])\r\nfor i in range(len(boolean_lists)):\r\n    category_filtered[i] = list(compress(elements, boolean_lists[i]))\r\n# Assign your output to the OUT variable.\r\nOUT = category_filtered\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "6bdfd4171722476393a0d505e7923880",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "98afaa1aa4d241b6a324180d40120d4b",
          "Name": "IN[0]",
          "Description": "Input #0",
