    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Define your three lists\r\nlist1 = IN[0]\r\nlist2 = IN[1]\r\nlist3 = IN[2]\r\n\r\n# Initialize an empty result list\r\nresult_list = []\r\n\r\n# Iterate through the indices of the lists\r\nfor i in range(len(list1)):\r\n    # Check if the value exists in list1, list2, or list3\r\n    if list1[i]:\r\n        result_list.append(list1[i])\r\n    elif list2[i]:\r\n        result_list.append(list2[i])\r\n    else:  # No need for the else block if you are sure there will be a value in one of the lists\r\n        result_list.append(list3[i])\r\n\r\n# Output the result list\r\nOUT = result_list\r\n\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d44bc3a20f404ccabb87cfc197d4c3b7",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "0dd4249d048f4a02a2496b6ff31813d7",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9cbced85703446a99f5c7a9c677aa620",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b1a5da578320475fa1ae1c15d14f763d",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "f7dc4c7e30c34b0b8b6c5e9572a65eb4",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Example input lists (replace these with your actual lists)\r\nlist1 = IN[0]  # List 1 with numbers like \"01\", \"02\", ...\r\nlist2 = IN[1]  # List 2 with numbers like \"03\", \"04\", ...\r\nlist3 = IN[2]  # List 3 with numbers like \"05\", \"06\", ...\r\n\r\n# Check if all lists have the same length\r\nif len(set(map(len, [list1, list2, list3]))) == 1:\r\n    # Combine values from all lists at each index\r\n    combined_values = [\"\".join(values) for values in zip(list1, list2, list3)]\r\n    OUT = combined_values\r\nelse:\r\n    OUT = \"Error: Lists have different lengths.\"\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0de42515662c4cf794b56c2ae31beed0",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "4342e4b3957c43d28f9e176330f9a64c",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "56b13f77197e416b952a99602db93e16",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f1a614f520054084aaa7ae5121e9ef7b",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "7a4bbd3e2af542e090c2bd93a2ea7f30",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
