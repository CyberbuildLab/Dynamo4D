    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Dynamo Script to Group Elements by 4D_Task_ID Parameter\r\n# Input parameters\r\nfourD_Task_ID_parameter_name = \"4D_Task_ID\"  # Replace with the actual name of the 4D_Task_ID parameter\r\n\r\n# Initialize an empty dictionary to store grouped elements\r\ngrouped_elements_dict = {}\r\nID_list = []\r\n\r\nelement_list = IN[0]\r\n\r\n# Iterate through all elements in the model\r\nfor element in element_list:\r\n    # Get the value of the 4D_Task_ID parameter for the current element\r\n    fourD_Task_ID_value = element.GetParameterValueByName(fourD_Task_ID_parameter_name)\r\n\r\n    # Check if the 4D_Task_ID_value is not None\r\n    if fourD_Task_ID_value is not None:\r\n        # Check if the 4D_Task_ID_value is already a key in the dictionary\r\n        if fourD_Task_ID_value in grouped_elements_dict:\r\n            # Append the current element to the list corresponding to the 4D_Task_ID_value key\r\n            grouped_elements_dict[fourD_Task_ID_value].append(element)\r\n        else:\r\n            # Create a new list with the current element and assign it to the 4D_Task_ID_value key\r\n            grouped_elements_dict[fourD_Task_ID_value] = [element]\r\n            #ID_list.append(fourD_Task_ID_value)\r\n\r\n# Convert the dictionary values to a list of sublists\r\ngrouped_elements = list(grouped_elements_dict.values())\r\n\r\n# Output the list of grouped elements\r\nOUT = grouped_elements_dict\r\n#OUT = [grouped_elements,ID_list]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "24e107a19283446aa7fa28084ef62581",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "1e9191a553804617a7edfa7858bfe588",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "544a5de9ae904abaaebce57034f72cf4",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
