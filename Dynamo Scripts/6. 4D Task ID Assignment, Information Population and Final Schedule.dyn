    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Input: Your list of elements, each containing a 4D task id parameter\r\nelements_with_task_ids = IN[0]\r\n\r\n# Define a function for natural sorting\r\ndef natural_sort_key(element):\r\n    task_id = element.GetParameterValueByName(\"4D_Task_ID\")\r\n    return [int(part) if part.isdigit() else part for part in task_id.split('.')]\r\n\r\n# Sort the elements using the natural sort key function\r\nsorted_elements = sorted(elements_with_task_ids, key=natural_sort_key)\r\n\r\n# Output the sorted list of elements\r\nOUT = sorted_elements\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "b2cbb5eee4ae4096b6658e2f378b6449",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "cf5f2d23f46f415eb18e5b1e77278971",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "340521215d0a4149a16af1bbdc575338",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Dynamo Script to Calculate Total Volume for Each 4D_Task_ID Sublist\r\n# Input parameters\r\ngrouped_elements = IN[0]  # List of sublists grouped by 4D_Task_ID\r\nvolume_parameter_name = \"Volume\"  # Replace with the actual name of the volume parameter\r\n\r\n# Initialize an empty list to store results\r\ntotal_volumes = []\r\n\r\n# Iterate through each sublist in the grouped_elements list\r\nfor sublist in grouped_elements:\r\n    # Initialize total volume for the current sublist\r\n    total_volume = 0\r\n\r\n    # Iterate through each element in the sublist\r\n    for element in sublist:\r\n        # Get the volume parameter value for the current element\r\n        volume_value = element.GetParameterValueByName(volume_parameter_name)\r\n\r\n        # Check if volume_value is not None (to handle potential null values)\r\n        if volume_value is not None:\r\n            # Add the volume to the total_volume\r\n            total_volume += volume_value\r\n\r\n    # Append the total_volume to the result list for the current sublist\r\n    total_volumes.append(total_volume)\r\n\r\n# Output the list of total volumes for each 4D_Task_ID sublist\r\nOUT = total_volumes\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "6e845ee711f247489389231970e5cf53",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "a5462e97ce754cb898d2566e3f6fa84d",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "eb3e8afe4b484c25b8b95de743855371",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Dynamo Script to Group Elements by 4D_Task_ID Parameter\r\n# Input parameters\r\nfourD_Task_ID_parameter_name = \"4D_Task_ID\"  # Replace with the actual name of the 4D_Task_ID parameter\r\n\r\n# Initialize an empty dictionary to store grouped elements\r\ngrouped_elements_dict = {}\r\n\r\nElements = IN[0]\r\n\r\n# Iterate through all elements in the model\r\nfor element in Elements:\r\n    # Get the value of the 4D_Task_ID parameter for the current element\r\n    fourD_Task_ID_value = element.GetParameterValueByName(fourD_Task_ID_parameter_name)\r\n\r\n    # Check if the 4D_Task_ID_value is not None\r\n    if fourD_Task_ID_value is not None:\r\n        # Check if the 4D_Task_ID_value is already a key in the dictionary\r\n        if fourD_Task_ID_value in grouped_elements_dict:\r\n            # Append the current element to the list corresponding to the 4D_Task_ID_value key\r\n            grouped_elements_dict[fourD_Task_ID_value].append(element)\r\n        else:\r\n            # Create a new list with the current element and assign it to the 4D_Task_ID_value key\r\n            grouped_elements_dict[fourD_Task_ID_value] = [element]\r\n\r\n# Convert the dictionary values to a list of sublists\r\ngrouped_elements = list(grouped_elements_dict.values())\r\n\r\n# Output the list of grouped elements\r\nOUT = grouped_elements\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "85e765bdfe884cf49e9e3b66c2a3a6a8",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "7a1da896ef8c40ef86f14878d9d4fc23",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "3ced4749b6df4dfb8463879131b6e051",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Dynamo Script to Extract Task_Construction_Sequence values for Each 4D_Task_ID Sublist\r\n# Input parameters\r\ngrouped_elements = IN[0]  # List of sublists grouped by 4D_Task_ID\r\nsequence_parameter_name = \"Task_Construction_Sequence\"  # Replace with the actual name of the sequence parameter\r\n\r\n# Initialize an empty list to store results\r\nunique_sequence_values_lists = []\r\n\r\n# Iterate through each sublist in the grouped_elements list\r\nfor sublist in grouped_elements:\r\n    # Initialize a set to store unique sequence values for the current sublist\r\n    unique_sequence_values_set = set()\r\n\r\n    # Iterate through each element in the sublist\r\n    for element in sublist:\r\n        # Get the sequence parameter value for the current element\r\n        sequence_value = element.GetParameterValueByName(sequence_parameter_name)\r\n\r\n        # Check if sequence_value is not None (to handle potential null values)\r\n        if sequence_value is not None:\r\n            # Add the sequence_value to the set to ensure uniqueness\r\n            unique_sequence_values_set.add(sequence_value)\r\n\r\n    # Convert the set to a list and append it to the result list for the current sublist\r\n    unique_sequence_values_list = list(unique_sequence_values_set)\r\n    unique_sequence_values_lists.append(unique_sequence_values_list)\r\n\r\n# Output the list of unique Task_Construction_Sequence values for each group\r\nOUT = unique_sequence_values_lists\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "88da2e850b9044a2a19d2215101c3ba9",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "13b7fc2ef65c4dafb510fd9fd91b7f47",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ccf559f9a4214596b3a4a34fcc02589d",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
