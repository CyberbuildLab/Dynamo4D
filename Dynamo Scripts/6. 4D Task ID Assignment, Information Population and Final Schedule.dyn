    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Import necessary Dynamo libraries\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Input parameter\r\ninput_list = IN[0]  # The input list to be chopped\r\n\r\n# Function to chop the list into sublists with dynamic length\r\ndef chop_list(input_list):\r\n    chunk_size = len(input_list)\r\n    return [input_list[i:i + chunk_size] for i in range(0, len(input_list), chunk_size)]\r\n\r\n# Execute the function\r\noutput_list = chop_list(input_list)\r\n\r\n# Output the result\r\nOUT = output_list\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "c840643d6845485f8fb6cbb54d8ecbaa",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "dcafe6261c314d06a530823dc2749ba3",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "b567b26bc584401ea99e41f80c71e719",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    }
